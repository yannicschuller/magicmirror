# ---------------------------------------------------------------------------
# Magic Mirror – Konfiguration (kopieren nach .env)
# ---------------------------------------------------------------------------

# Port, unter dem der Spiegel im LAN erreichbar ist
MIRROR_PORT=8080

# Öffentliche Adresse des Servers (für den OIDC-Callback) – exakt so, wie der
# Browser das Admin-Panel aufruft. Redirect-URI beim Provider: ${BASE_URL}/auth/callback
BASE_URL=http://magicmirror.local:8080

# --- OIDC (Pflicht fürs Admin-Panel) – z. B. Authentik, Keycloak, Authelia, Pocket ID, Zitadel, Google
OIDC_ISSUER_URL=https://auth.example.com/application/o/magicmirror/
OIDC_CLIENT_ID=magicmirror
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email
# Zugriff einschränken (kommagetrennt, leer = jeder angemeldete Benutzer)
OIDC_ALLOWED_EMAILS=
OIDC_ALLOWED_GROUPS=
OIDC_GROUPS_CLAIM=groups
# Beim Abmelden auch beim Identity Provider abmelden
OIDC_IDP_LOGOUT=false

# Zufälliger String (mind. 32 Zeichen) für die Session-Cookies.
# Leer lassen = wird automatisch erzeugt und in ./data gespeichert.
SESSION_SECRET=

# Hinter einem Reverse-Proxy (Traefik, Caddy, nginx …): true
TRUST_PROXY=

TZ=Europe/Berlin

# --- Optionale Dienste: camera (go2rtc), adsb (eigener ADS-B-Stick), fr24 (Flightradar24-Feeder + adsb)
COMPOSE_PROFILES=

# --- ADS-B-Empfänger (Profil adsb/fr24)
ADSB_LAT=
ADSB_LON=
ADSB_ALT=50m
ADSB_GAIN=autogain
ADSB_PPM=0
ADSB_SDR_SERIAL=
TAR1090_PORT=8090
ULTRAFEEDER_CONFIG=
ADSB_MLAT_USER=

# --- Flightradar24 (Profil fr24) – Sharing-Key siehe README
FR24_SHARING_KEY=
