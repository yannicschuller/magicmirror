# ---------------------------------------------------------------------------
# Magic Mirror – configuration (copy to .env, or let install.sh write it)
# ---------------------------------------------------------------------------

# Web port of the mirror and admin panel
MIRROR_PORT=8080

# Public address exactly as the browser opens the admin panel
# (needed for OIDC; redirect URI at your provider: ${BASE_URL}/auth/callback)
BASE_URL=http://mirror.local:8080

# Language & format of a fresh install: en-GB, en-US, de-DE, de-AT, de-CH
# (can be changed later in the admin panel → General)
MM_LOCALE=en-GB
TZ=Europe/Berlin

# Optional services (comma-separated): kiosk, autoupdate, camera, adsb, fr24
COMPOSE_PROFILES=

# --- Admin login -----------------------------------------------------------
# Username/password accounts live in ./data/users.json (scrypt hashes).
# Create one: open /login with the setup code from the log, or run
#   docker compose exec magicmirror node src/cli.js passwd admin
LOCAL_LOGIN=true
# Optionally create the first account from here (only if none exists yet;
# remove the password again afterwards):
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Optional: OIDC / SSO (Authentik, Keycloak, Authelia, Pocket ID, Zitadel, Google …)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# empty = public client with PKCE
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email
# Restrict access (comma-separated, empty = every signed-in user)
OIDC_ALLOWED_EMAILS=
OIDC_ALLOWED_GROUPS=
OIDC_GROUPS_CLAIM=groups
# Also sign out at the identity provider
OIDC_IDP_LOGOUT=false

# Random string (32+ characters) for signing session cookies.
# Empty = generated automatically and stored in ./data
SESSION_SECRET=

# Behind a reverse proxy (Traefik, Caddy, nginx …): true
TRUST_PROXY=

# --- Kiosk (profile kiosk) ------------------------------------------------
# cog = WPE WebKit (light, default) · chromium = fallback if a page misbehaves
KIOSK_BROWSER=cog
# Page shown on HDMI (default: this server)
KIOSK_URL=
# Extra Chromium flags, e.g. --force-device-scale-factor=1.25
KIOSK_FLAGS=

# --- Auto-update (profile autoupdate) ----------------------------------------
UPDATE_TIME=04:00
# pull = prebuilt images from the registry, build = build on this device
UPDATE_MODE=pull
# also git pull the checkout (docker-compose.yml, docs …)
UPDATE_GIT=true

# --- Images (forks / pinning) -------------------------------------------------
MM_REGISTRY=ghcr.io/yannicschuller
MM_TAG=latest

# --- ADS-B receiver (profile adsb / fr24) -------------------------------------
ADSB_LAT=
ADSB_LON=
ADSB_ALT=50m
ADSB_GAIN=autogain
ADSB_PPM=0
ADSB_SDR_SERIAL=
TAR1090_PORT=8090
ULTRAFEEDER_CONFIG=
ADSB_MLAT_USER=

# --- Flightradar24 (profile fr24) – how to get a sharing key: see README
FR24_SHARING_KEY=
